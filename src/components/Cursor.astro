---
import { heart } from '../icons';
---

<div class="cursor" aria-hidden="true">
  <div class="blob">
    <svg class="heart" viewBox="0 0 24 24"><path d={heart}></path></svg>
  </div>
</div>

<style>
  .cursor {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 10;
    mix-blend-mode: difference;
    pointer-events: none;
    opacity: 0;
    will-change: transform;
  }

  .blob {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #fff;
    translate: -50% -50%;
    transition:
      width 0.35s cubic-bezier(0.3, 1.4, 0.5, 1),
      height 0.35s cubic-bezier(0.3, 1.4, 0.5, 1);
  }

  .heart {
    position: absolute;
    width: 22px;
    height: 22px;
    fill: #000;
    opacity: 0;
    scale: 0.5;
    transition:
      opacity 0.2s,
      scale 0.35s cubic-bezier(0.3, 1.4, 0.5, 1);
  }

  /* над ссылками и кнопками: маленькая точка */
  .cursor[data-state='dot'] .blob {
    width: 10px;
    height: 10px;
  }

  /* над фото: сердечко — намёк на двойной клик */
  .cursor[data-state='like'] .blob {
    width: 52px;
    height: 52px;
  }

  .cursor[data-state='like'] .heart {
    opacity: 1;
    scale: 1;
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 600px) {
    :global([data-mode='informal']) .cursor {
      display: block;
    }

    /* !important — иначе cursor: pointer у кнопок перебивает, и курсор двоится */
    :global([data-mode='informal'] *) {
      cursor: none !important;
    }

    /* диалог рисуется поверх всего, кружок под ним не видно */
    :global([data-mode='informal'] dialog *) {
      cursor: auto !important;
    }

    :global([data-mode='informal'] dialog :is(a, button)) {
      cursor: pointer !important;
    }
  }
</style>

<script>
  const cursor = document.querySelector<HTMLElement>('.cursor')!;

  function stateFor(target: EventTarget | null) {
    const el = target instanceof Element ? target.closest('.photo, a, button:not(.open)') : null;
    if (!el) return 'default';
    return el.matches('.photo') ? 'like' : 'dot';
  }

  window.addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse') return;
    cursor.style.transform = `translate(${e.clientX}px, ${e.clientY}px)`;
    cursor.style.opacity = '1';
    cursor.dataset.state = stateFor(e.target);
  });

  document.documentElement.addEventListener('pointerleave', () => {
    cursor.style.opacity = '0';
  });
</script>
