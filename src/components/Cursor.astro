---
import { heart } from '../icons';
---

<!-- обычный курсор везде; только над фото в informal он превращается в сердечко — намёк на двойной клик -->
<div class="cursor" aria-hidden="true">
  <div class="blob">
    <svg class="heart" viewBox="0 0 24 24"><path d={heart}></path></svg>
  </div>
</div>

<style>
  .cursor {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 10;
    mix-blend-mode: difference;
    pointer-events: none;
    will-change: transform;
  }

  .blob {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #fff;
    translate: -50% -50%;
    opacity: 0;
    scale: 0.3;
    transition:
      opacity 0.2s,
      scale 0.35s var(--spring);
  }

  .heart {
    width: 22px;
    height: 22px;
    fill: #000;
  }

  .cursor[data-state='like'] .blob {
    opacity: 1;
    scale: 1;
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 600px) {
    :global([data-mode='informal']) .cursor {
      display: block;
    }

    /* системный курсор прячем только над самим фото, кнопки на нём остаются обычными */
    :global([data-mode='informal'] .photo),
    :global([data-mode='informal'] .photo *:not(a, button, a *, button *)) {
      cursor: none;
    }
  }
</style>

<script>
  const cursor = document.querySelector<HTMLElement>('.cursor')!;

  function stateFor(target: EventTarget | null) {
    if (!(target instanceof Element)) return 'default';
    return target.closest('.photo') && !target.closest('a, button') ? 'like' : 'default';
  }

  window.addEventListener('pointermove', (e) => {
    if (e.pointerType !== 'mouse') return;
    cursor.style.transform = `translate(${e.clientX}px, ${e.clientY}px)`;
    cursor.dataset.state = stateFor(e.target);
  });

  document.documentElement.addEventListener('pointerleave', () => {
    cursor.dataset.state = 'default';
  });
</script>
