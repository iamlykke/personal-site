---
import { copy } from '../content';
---

<div class="strip strip-top"></div>
<div class="strip strip-bottom"></div>
<div class="strip strip-left"></div>
<div class="strip strip-right"></div>

<div class="marquee" aria-hidden="true" data-text={copy.marquee}>
  <svg>
    <path id="marquee-path" fill="none"></path>
    <text dominant-baseline="central">
      <textPath href="#marquee-path" lengthAdjust="spacing"></textPath>
    </text>
  </svg>
</div>

<style>
  .marquee {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s;
  }

  .strip:hover ~ .marquee {
    opacity: 1;
  }

  svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  text {
    fill: #fff;
    font: 500 11px var(--mono);
    letter-spacing: 0.14em;
  }

  .strip {
    position: absolute;
    z-index: 3;
  }

  .strip-top,
  .strip-bottom {
    left: 0;
    right: 0;
    height: var(--band);
  }

  .strip-top {
    top: 0;
  }

  .strip-bottom {
    bottom: 0;
  }

  .strip-left,
  .strip-right {
    top: var(--band);
    bottom: var(--band);
    width: var(--band);
  }

  .strip-left {
    left: 0;
  }

  .strip-right {
    right: 0;
  }

  /* на тач-устройствах наведения нет — строку не показываем вовсе */
  @media (hover: none), (max-width: 599px) {
    .marquee,
    .strip {
      display: none;
    }
  }
</style>

<script>
  const SPEED = 55; // px/s
  const PANEL_RADIUS = 18;

  const marquee = document.querySelector<HTMLElement>('.marquee')!;
  const frame = marquee.parentElement!;
  const path = marquee.querySelector('path')!;
  const textPath = marquee.querySelector('textPath')!;
  const unit = `${marquee.dataset.text}  ✦  `;

  let unitWidth = 0;
  let perimeter = 0;
  let offset = 0;

  function measureUnit() {
    const ctx = document.createElement('canvas').getContext('2d')!;
    ctx.font = "500 11px 'JetBrains Mono'";
    // canvas не учитывает letter-spacing, добавляем руками
    return ctx.measureText(unit).width + unit.length * 11 * 0.14;
  }

  function layout() {
    const w = frame.offsetWidth;
    const h = frame.offsetHeight;
    const s = parseFloat(getComputedStyle(frame).paddingTop) / 2;
    const r = PANEL_RADIUS + s;

    path.setAttribute(
      'd',
      `M${s + r},${s} H${w - s - r} A${r},${r} 0 0 1 ${w - s},${s + r} ` +
        `V${h - s - r} A${r},${r} 0 0 1 ${w - s - r},${h - s} ` +
        `H${s + r} A${r},${r} 0 0 1 ${s},${h - s - r} ` +
        `V${s + r} A${r},${r} 0 0 1 ${s + r},${s} Z`,
    );

    perimeter = 2 * (w - 2 * s - 2 * r) + 2 * (h - 2 * s - 2 * r) + 2 * Math.PI * r;
    const n = Math.max(1, Math.round(perimeter / unitWidth));
    textPath.textContent = unit.repeat(n * 2);
    textPath.setAttribute('textLength', String(perimeter * 2));
  }

  let last = performance.now();
  function tick(now: number) {
    offset -= (SPEED * (now - last)) / 1000;
    if (offset <= -perimeter) offset += perimeter;
    textPath.setAttribute('startOffset', String(offset));
    last = now;
    requestAnimationFrame(tick);
  }

  // на тач-устройствах строка скрыта — и анимацию не крутим зря
  const hidden = matchMedia('(hover: none), (max-width: 599px)').matches;

  if (!hidden) document.fonts.ready.then(() => {
    unitWidth = measureUnit();
    layout();
    new ResizeObserver(layout).observe(frame);

    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      requestAnimationFrame(tick);
    }
  });
</script>
