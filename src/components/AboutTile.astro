---
import Expandable from './Expandable.astro';
import Icon from './Icon.astro';
import ContactCta from './ContactCta.astro';
import FlagRS from './FlagRS.astro';
import { copy, about, links } from '../content';
import { hobbyIcons, type HobbyIcon } from '../icons';

const resume = links.find((link) => link.label === 'Resume')!;
---

<Expandable id="about-dialog" label="About" bg="var(--bg-about)" class="about">
  <span class="arrow arrow-corner" aria-hidden="true"><Icon name="arrow" /></span>
  <p class="label">About</p>
  <h1 class="heading">I'm Sergei,<br />a frontend engineer.</h1>
  <p class="text">{copy.about}</p>

  <Fragment slot="head">
    <p class="label">About</p>
    <h2 class="heading big">Hi, I'm Sergei</h2>
  </Fragment>

  <div slot="body" class="body">
    <div class="intro">
      {about.intro.map((text) => <p>{text}</p>)}
    </div>

    <dl class="facts">
      {
        about.facts.map((fact) => (
          <div class:list={{ 'flag-zone': fact.flag }}>
            <dt class="label">{fact.label}</dt>
            <dd>
              {fact.value}
              {fact.flag && <FlagRS />}
            </dd>
          </div>
        ))
      }
    </dl>

    <section class="section">
      <div class="section-head">
        <h3 class="label">Experience</h3>
        <a class="label resume" href={resume.href} target="_blank" rel="noopener">Full resume <Icon name="arrow" /></a>
      </div>
      <ol class="jobs">
        {
          about.experience.map((job) => (
            <li>
              <span class="years">{job.years}</span>
              <div>
                <p class="job-title">
                  {job.company} <span>· {job.role}</span>
                </p>
                <p class="job-text">{job.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section">
      <div class="section-head">
        <h3 class="label">Off the clock</h3>
      </div>
      <ul class="hobbies">
        {
          about.hobbies.map((hobby, i) => (
            <li class:list={['hobby', `hobby-${hobby.icon}`]}>
              <div class="hobby-top">
                <span class="hobby-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" set:html={hobbyIcons[hobby.icon as HobbyIcon]} />
                </span>
                <span class="hobby-num">0{i + 1}</span>
              </div>
              <h4>{hobby.title}</h4>
              <ul class="tags">
                {hobby.tags.map((tag) =>
                  typeof tag === 'string' ? (
                    <li>{tag}</li>
                  ) : (
                    <li class="tag-link">
                      <a href={tag.href} target="_blank" rel="noopener">
                        {tag.label} <Icon name="arrow" />
                      </a>
                    </li>
                  ),
                )}
              </ul>
            </li>
          ))
        }
      </ul>
    </section>

    <ContactCta />
  </div>
</Expandable>

<style>
  :global(.about) {
    background: var(--bg-about);
  }

  :global(.about) h1 {
    font-size: var(--fs-about);
    line-height: 0.98;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-bottom: 8px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 60ch;
    font-size: clamp(18px, 1.5vw, 22px);
    line-height: 1.45;
  }

  .intro p {
    margin: 0;
  }

  /* факты — в ряд, переносятся по ширине окна */
  .facts {
    margin: 0;
    display: grid;
    /* 4 в ряд или 2×2 — без «хвостов» вроде 3+1 */
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 22px 16px;
  }

  .facts div {
    padding-top: 12px;
    border-top: 1.5px solid currentColor;
  }

  dd {
    margin: 6px 0 0;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-bottom: 12px;
    border-bottom: 1.5px solid currentColor;
  }

  .section-head h3 {
    margin: 0;
  }

  .resume {
    transition: color 0.25s;
  }

  .resume:hover {
    color: var(--accent);
  }

  /* опыт: годы слева, компания и пара строк справа */
  .jobs {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .jobs li {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 6px 20px;
    padding: 18px 0;
    border-bottom: 1px solid rgba(20, 22, 28, 0.15);
  }

  .years {
    padding-top: 4px;
    font: 500 12px var(--mono);
    letter-spacing: 0.06em;
    color: var(--label);
  }

  .job-title {
    margin: 0 0 6px;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .job-title span {
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    font-size: 16px;
    color: var(--muted);
  }

  .job-text {
    margin: 0;
    max-width: 62ch;
    color: var(--muted);
    font-size: 15px;
  }

  /* хобби — 4 карточки 2×2: иконка, название, теги */
  .hobbies {
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .hobby {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 190px;
    padding: 18px;
    border-radius: 14px;
    background: rgba(20, 22, 28, 0.06);
    transition:
      background 0.5s,
      color 0.5s,
      translate 0.4s var(--spring),
      rotate 0.4s var(--spring);
  }

  .hobby-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: auto;
  }

  .hobby-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    /* самолёт улетает за край кружка, а не за край карточки */
    overflow: hidden;
  }

  .hobby-icon svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hobby-num {
    font: 500 12px var(--mono);
    letter-spacing: 0.08em;
    opacity: 0.6;
  }

  .hobby h4 {
    margin: 0;
    font-size: clamp(24px, 2.2vw, 32px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .tags {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tags li {
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(20, 22, 28, 0.08);
    font: 500 12px/1 var(--mono);
  }

  /* тег-ссылка — с обводкой, чтобы отличался от обычных */
  .tags .tag-link {
    padding: 0;
    background: none;
  }

  .tags a {
    display: block;
    padding: 5px 9px;
    border: 1px solid currentColor;
    border-radius: 999px;
    transition:
      background 0.25s,
      color 0.25s;
  }

  .tags a:hover {
    background: var(--ink);
    color: #fff;
  }

  /* informal: цветные карточки «шахматкой», при наведении карточка подпрыгивает, иконка оживает */
  :global([data-mode='informal']) .hobby-music {
    background: var(--yellow);
  }

  :global([data-mode='informal']) .hobby-camera {
    background: var(--pink);
  }

  :global([data-mode='informal']) .hobby-plane {
    background: var(--mint);
  }

  :global([data-mode='informal']) .hobby-trophy {
    background: var(--lavender);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    :global([data-mode='informal']) .hobby:hover {
      translate: 0 -4px;
      rotate: -1deg;
    }

    :global([data-mode='informal']) .hobby:nth-child(even):hover {
      rotate: 1deg;
    }

    :global([data-mode='informal']) .hobby-music:hover svg {
      animation: hop 0.6s ease-in-out infinite alternate;
    }

    :global([data-mode='informal']) .hobby-camera:hover svg {
      animation: snap 0.9s ease-out infinite;
    }

    :global([data-mode='informal']) .hobby-plane:hover svg {
      animation: fly 1.2s ease-in-out infinite;
    }

    :global([data-mode='informal']) .hobby-trophy:hover svg {
      animation: wiggle 0.5s ease-in-out infinite alternate;
    }
  }

  /* нота подпрыгивает в такт */
  @keyframes hop {
    from {
      translate: 0 2px;
      rotate: -6deg;
    }
    to {
      translate: 0 -4px;
      rotate: 6deg;
    }
  }

  /* «щелчок» затвора */
  @keyframes snap {
    0%,
    60%,
    100% {
      scale: 1;
    }
    70% {
      scale: 0.75;
    }
    80% {
      scale: 1.15;
    }
  }

  /* самолёт улетает за край и прилетает с другой стороны */
  @keyframes fly {
    0% {
      translate: 0 0;
      opacity: 1;
    }
    40% {
      translate: 18px -18px;
      opacity: 0;
    }
    41% {
      translate: -18px 18px;
      opacity: 0;
    }
    80%,
    100% {
      translate: 0 0;
      opacity: 1;
    }
  }

  /* кубок покачивается */
  @keyframes wiggle {
    from {
      rotate: -14deg;
    }
    to {
      rotate: 14deg;
    }
  }

  @container (max-width: 559px) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .jobs li {
      grid-template-columns: 1fr;
    }
  }

  @container (max-width: 419px) {
    .hobbies {
      grid-template-columns: 1fr;
    }
  }
</style>
