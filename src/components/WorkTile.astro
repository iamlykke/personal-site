---
import { Image } from 'astro:assets';
import Expandable from './Expandable.astro';
import Icon from './Icon.astro';
import ContactCta from './ContactCta.astro';
import ProjectVideo from './ProjectVideo.astro';
import { copy, projects, featuredProject } from '../content';

const shotSizes = '(max-width: 599px) 100vw, (max-width: 899px) 50vw, 33vw';
// превью в раскрытом списке: на всю ширину окна (~60% экрана на десктопе);
// у скриншотов мелкий текст, поэтому там quality={90}
const cardSizes = '(max-width: 899px) 100vw, 60vw';
// превью на плитке держит пропорции своего кадра — всегда горизонтальное, не вытягивается в высоту
const featuredMedia = featuredProject.video?.poster ?? featuredProject.image;
const shotRatio = featuredMedia ? `${featuredMedia.width} / ${featuredMedia.height}` : '16 / 10';
---

<Expandable id="work-dialog" label="My work" bg="var(--bg-work)" class="work">
  <div class:list={['shot', { 'shot-video': featuredProject.video }]} style={`aspect-ratio: ${shotRatio}`}>
    {
      featuredProject.video ? (
        <ProjectVideo name={featuredProject.name} video={featuredProject.video} />
      ) : featuredProject.image ? (
        <Image
          src={featuredProject.image}
          alt={`${featuredProject.name} website`}
          widths={[400, 700, 1000]}
          sizes={shotSizes}
          loading="eager"
        />
      ) : (
        <div class="placeholder">project screenshot</div>
      )
    }
  </div>
  <div class="row">
    <h2 class="heading">My work</h2>
    <span class="arrow" aria-hidden="true"><Icon name="arrow" /></span>
  </div>
  <p class="text">{copy.work}</p>

  <Fragment slot="head">
    <p class="label">Selected work · {String(projects.length).padStart(2, '0')}</p>
    <h2 class="heading big">My work</h2>
  </Fragment>

  <Fragment slot="body">
    <ul class="projects">
      {
        projects.map((p) => {
          // кликабельно только превью, и только если у проекта есть ссылка
          const Shot = p.url ? 'a' : 'div';
          return (
            <li>
              <Shot
                class="project-shot"
                href={p.url}
                target={p.url && '_blank'}
                rel={p.url && 'noopener'}
                aria-label={p.url && `Open ${p.name}`}
              >
                {p.video ? (
                  <ProjectVideo name={p.name} video={p.video} />
                ) : p.image ? (
                  <Image
                    src={p.image}
                    alt={p.url ? '' : `${p.name} website`}
                    widths={[600, 900, 1200, 1480]}
                    sizes={cardSizes}
                    quality={90}
                  />
                ) : (
                  <div class="placeholder">screenshot · {p.name}</div>
                )}
                {p.url && (
                  <span class="open-hint" aria-hidden="true">
                    Open <Icon name="arrow" />
                  </span>
                )}
              </Shot>
              <div class="project-title">
                <h3 class="project-name">{p.name}</h3>
                {p.host && <span class="project-host">{p.host}</span>}
              </div>
              <p class="project-desc">{p.description}</p>
              <ul class="project-stack" aria-label="Stack">
                {p.stack.map((tech) => <li>{tech}</li>)}
              </ul>
            </li>
          );
        })
      }
    </ul>

    <ContactCta />
  </Fragment>
</Expandable>

<style>
  :global(.work) {
    background: var(--bg-work);
  }

  .shot,
  .project-shot {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
  }

  /* по центру свободного места над заголовком; на низких плитках сжимается по высоте,
     и видео (object-fit: contain) остаётся целиком */
  .shot {
    flex: 0 1 auto;
    min-height: 0;
    margin-block: auto;
  }

  /* <Image> и заглушка заполняют контейнер целиком */
  .shot > :global(*),
  .project-shot > :global(*) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .shot :global(img),
  .project-shot :global(img) {
    object-fit: cover;
    object-position: center top;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  :global(.work) h2 {
    font-size: var(--fs-work);
  }

  /* по одному проекту в строке, крупные превью; окно скроллится */
  .projects {
    display: grid;
    grid-template-columns: 1fr;
    gap: 44px;
  }

  .projects > li {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* пропорции экрана — широкие скриншоты не режутся в узкую полоску */
  .project-shot {
    display: block;
    aspect-ratio: 16 / 10;
  }

  /* лёгкое затемнение превью при наведении */
  .project-shot::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(20, 22, 28, 0.22);
    opacity: 0;
    transition: opacity 0.3s;
  }

  /* плашка «Open» — в стиле переключателя режимов */
  .project-shot > .open-hint {
    position: absolute;
    inset: auto auto 14px 14px;
    z-index: 1;
    width: auto;
    height: auto;
    padding: 8px 13px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.12);
    color: var(--ink);
    font: 500 12px/1 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0;
    translate: 0 8px;
    transition:
      opacity 0.3s,
      translate 0.4s var(--spring);
  }

  a.project-shot:is(:hover, :focus-visible)::after {
    opacity: 1;
  }

  .project-shot:is(:hover, :focus-visible) > .open-hint {
    opacity: 1;
    translate: 0 0;
  }

  /* на тач-экранах наведения нет — плашка видна сразу, без затемнения */
  @media (hover: none) {
    .project-shot > .open-hint {
      opacity: 1;
      translate: 0 0;
    }
  }

  .project-name {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  /* название слева, домен справа — всегда на одной линии.
     Отступы: превью → название 18px, название ↔ описание вплотную (одна группа), описание → чипы 12px */
  .project-title {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-top: 6px;
  }

  .project-title + .project-desc {
    margin-top: -6px;
  }

  .project-host {
    flex: none;
    font: 400 12px var(--mono);
    color: var(--muted);
  }

  .project-desc {
    margin: 0;
    max-width: 62ch;
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
    /* \n в описании из content.ts — перенос строки */
    white-space: pre-line;
  }

  /* технологии — чипы с заливкой, лишние переносятся */
  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .project-stack li {
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(20, 22, 28, 0.08);
    font: 500 12px/1 var(--mono);
  }

  @media (max-width: 899px) {
    /* плитка тут растёт по контенту — даём видео его родные пропорции на всю ширину */
    .shot-video {
      flex: none;
      aspect-ratio: 960 / 632;
    }
  }
</style>

